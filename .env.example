#복사 후 파일명 .env로 수정
#이후 빈칸은 받은 내용 기입

# DB 접속 주소: 로컬(MariaDB)은 주석 그대로 두기. AWS RDS(MySQL)에서만 주석을 풀고 엔드포인트 입력
# (빈 값으로 두면 기본 주소 대신 빈 문자열이 들어가므로 반드시 주석 처리)
#DB_URL=jdbc:mysql://<RDS 엔드포인트>:3306/hawe?connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true
DB_USERNAME=hawe_db
DB_PASSWORD=
#JWT secret - 32bit의 랜덤 문자열을 넣어야 함
#git bash --> openssl rand -base64 32 실행 / 있는 값
JWT_SECRET=

# 미션 문장 AI (B8) - 운영 측 LLM 게이트웨이(LiteLLM, Bedrock) 사용
# 따옴표 없이 입력 (.properties 형식이라 따옴표도 값에 포함됨)
# 실제 키는 이 파일에 절대 적지 말 것 (이 파일은 git에 올라감). 본인 .env에만 입력
HAWE_MISSION_AI_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
# 게이트웨이 모델 이름 (/v1/models로 확인): bedrock-haiku, bedrock-sonnet
LLM_MODEL=bedrock-haiku
