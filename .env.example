# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# MariaDB credentials (see spring.datasource.* in application.properties)
DB_USERNAME=hawe_db
DB_PASSWORD=

# HMAC signing secret for JWT access/refresh tokens (see jwt.secret in application.properties)
# Must be a long random string (32+ bytes). Do not reuse the dev default from application.properties.
JWT_SECRET=
