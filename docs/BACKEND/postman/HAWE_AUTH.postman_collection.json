{
  "info": {
    "name": "HA'WE - AUTH API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "AUTH API(register/login/refresh/GET me) 통합 테스트. 서버(http://localhost:8080) 필요. 폴더 1~4를 순서대로 Collection Runner로 실행. 1-1을 실행할 때마다 run 값이 새로 만들어져 새 계정이 생성되므로 반복 실행해도 됩니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. 회원가입",
      "item": [
        {
          "name": "1-1 정상 가입 → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"password\":\"password1\",\"nickname\":\"authnick\",\"email\":\"auth_{{run}}@test.com\",\"agreeTerms\":true,\"agreePrivacy\":true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"run\", Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"id/email/nickname returned\", () => { pm.expect(j.id).to.be.a(\"number\"); pm.expect(j.email).to.eql(\"auth_\" + pm.collectionVariables.get(\"run\") + \"@test.com\"); pm.expect(j.nickname).to.eql(\"authnick\"); });",
                  "pm.test(\"password is never returned\", () => { const s = pm.response.text(); pm.expect(s).to.not.include(\"password\"); pm.expect(s).to.not.include(\"passwordHash\"); });"
                ]
              }
            }
          ]
        },
