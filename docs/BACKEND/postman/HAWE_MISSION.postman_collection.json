    {
      "name": "2.5 시드 SQL 출력 (미션 2개)",
      "item": [
        {
          "name": "SQL 출력 (Postman Console 확인)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/missions/today",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "missions",
                "today"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const g = pm.collectionVariables.get(\"groupId\"), run = pm.collectionVariables.get(\"run\");",
                  "const sql = [",
                  "  \"-- Run this in the hawe DB, then run folder 3.\",",
                  "  \"INSERT INTO missions (group_id, content, category, template, params, slot_no, published_at, deadline_at, mission_date) VALUES\",",
                  "  \"(\" + g + \", '\\\"퇴근길\\\"로 삼행시 지어줘', '감성', 'TEXT_ACROSTIC', '{\\\"word\\\":\\\"퇴근길\\\"}', 1, NOW(), NOW() + INTERVAL 3 HOUR, CURDATE()),\",",
                  "  \"(\" + g + \", '[대상]은 무인도에 가면 제일 먼저 ___ 할 것 같다', '유머', 'TEXT_FILL_BLANK', JSON_OBJECT('sentence', '[대상]은 무인도에 가면 제일 먼저 ___ 할 것 같다', 'targetUserId', (SELECT id FROM users WHERE login_id = 'userb_\" + run + \"')), 2, NOW(), NOW() + INTERVAL 3 HOUR, CURDATE());\"",
                  "].join(\"\\n\");",
                  "console.log(sql);",
                  "pm.test(\"SQL printed to Postman Console (View > Show Postman Console)\", () => pm.expect(sql).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. 시드 후 조회 (SQL 실행 필요, 제출 전)",
      "item": [
        {
          "name": "3-1 오늘 미션 2개 (A)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/missions/today",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "missions",
                "today"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"2 missions ordered by slotNo (did you run the seed SQL?)\", () => { pm.expect(j.missions.length).to.eql(2); pm.expect(j.missions.map(m => m.slotNo)).to.eql([1, 2]); });",
                  "pm.test(\"all slots published -> nextPublishAt null\", () => pm.expect(j.nextPublishAt).to.eql(null));",
                  "const [m1, m2] = j.missions;",
                  "pm.test(\"mission 1 acrostic\", () => { pm.expect(m1.template).to.eql(\"TEXT_ACROSTIC\"); pm.expect(m1.media).to.eql(\"TEXT\"); pm.expect(m1.params).to.eql({word: \"퇴근길\"}); pm.expect(m1.submittedByMe).to.eql(false); pm.expect(m1.groupId).to.eql(Number(pm.collectionVariables.get(\"groupId\"))); pm.expect(m1.publishedAt).to.be.a(\"string\"); pm.expect(m1.deadlineAt).to.be.a(\"string\"); });",
                  "pm.test(\"mission 2 target expanded\", () => { pm.expect(m2.template).to.eql(\"TEXT_FILL_BLANK\"); pm.expect(m2.params).to.not.have.property(\"targetUserId\"); pm.expect(m2.params.target.nickname).to.eql(\"nickb\"); pm.expect(m2.params.target.userId).to.be.a(\"number\"); pm.expect(m2.params.sentence).to.include(\"___\"); });",
                  "pm.collectionVariables.set(\"missionId1\", m1.missionId);",
                  "pm.collectionVariables.set(\"missionId2\", m2.missionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "3-2 미션 단건 1 (A)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
