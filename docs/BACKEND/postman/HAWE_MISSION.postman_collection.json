              "path": [
                "api",
                "groups",
                "{{groupId}}",
                "missions",
                "today"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"one current mission\", () => { pm.expect(j.dailyMissionCount).to.eql(1); pm.expect(j.missions).to.have.length(1); });",
                  "const m = j.missions[0];",
                  "pm.test(\"MVP template and media\", () => { pm.expect([\"PHOTO_NOW\",\"PHOTO_GALLERY\",\"PHOTO_COLOR\",\"DRAW_SKETCH\",\"DRAW_A_TO_B\",\"TEXT_ACROSTIC\",\"TEXT_FILL_BLANK\"]).to.include(m.template); pm.expect([\"PHOTO\",\"TEXT\",\"DRAW\"]).to.include(m.media); });",
                  "pm.test(\"current mission contract\", () => { pm.expect(m.number).to.eql(1); pm.expect(m.slotNo).to.eql(1); pm.expect(m.content).to.be.a(\"string\"); pm.expect(m.content).to.not.include(\"[대상]\"); pm.expect(m.submittedByMe).to.eql(false); pm.expect(m.members).to.have.length(1); pm.expect(m.members[0].submitted).to.eql(false); pm.expect(m.publishedAt).to.match(/\\+09:00$/); pm.expect(m.deadlineAt).to.match(/\\+09:00$/); pm.expect(m.closesAt).to.match(/\\+09:00$/); pm.expect(j.nextPublishAt).to.eql(m.closesAt); });",
                  "pm.collectionVariables.set(\"missionId1\", m.missionId);"
                ]
              }
            }
          ]
        },
