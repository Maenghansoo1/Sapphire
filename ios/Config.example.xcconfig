// 이 파일을 Config.xcconfig 로 복사한 뒤 실제 값을 넣어 주세요. (Config.xcconfig 는 git 에 올라가지 않아요)
// xcconfig 에서는 "//" 가 주석이라 URL 은 https:/$()/ 형태로 써야 해요.

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// Spring 서버 주소. 비워 두면 디버그는 http://localhost:8080 을 써요. (실기기에서는 Mac 의 IP 로 바꿔 주세요)
API_BASE_URL = http:/$()/localhost:8080
